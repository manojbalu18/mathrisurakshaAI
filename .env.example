# ==========================================
# MathriSurakshaAI Configuration
# ==========================================

# LM Studio Local AI Server Settings
# Default port for LM Studio local server is 1234
LM_STUDIO_BASE_URL=http://localhost:1234/v1

# Optional: Specific model identifier loaded in LM Studio.
# If left empty, the application will automatically select the active model from LM Studio.
LM_STUDIO_MODEL=

# Request timeout in seconds for local model inferences
LM_STUDIO_TIMEOUT=30

# API Key (LM Studio accepts any string or 'lm-studio')
LM_STUDIO_API_KEY=lm-studio

# Live SMS Gateway (Optional: Fast2SMS API key for emergency SMS)
FAST2SMS_API_KEY=your-fast2sms-api-key-here
