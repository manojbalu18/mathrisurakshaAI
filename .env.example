# ==========================================
# MathriSurakshaAI Configuration (.env.example)
# ==========================================

# LM Studio Local AI Server Settings
# Default port for LM Studio local server is 1234
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1

# OpenAI-compatible Chat Completions Endpoint
LM_STUDIO_CHAT_ENDPOINT=http://127.0.0.1:1234/v1/chat/completions

# Model identifier loaded in LM Studio (e.g. qwen2.5-7b-instruct)
LM_STUDIO_MODEL=qwen2.5-7b-instruct

# Request timeout in seconds for local model inferences
LM_STUDIO_TIMEOUT=30

# API Key (LM Studio accepts any string or 'lm-studio')
LM_STUDIO_API_KEY=lm-studio

# ------------------------------------------
# ASHA Worker Contact Configuration (Placeholders)
# ------------------------------------------
ASHA_WORKER_NAME=RAMYA
ASHA_WORKER_PHONE=+919876543210
ASHA_ESCALATION_ENABLED=true

# ------------------------------------------
# Twilio Provider Configuration (Placeholders)
# ------------------------------------------
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+17372508034
TWILIO_TRIAL_MODE=true
